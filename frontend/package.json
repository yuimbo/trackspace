{
  "name": "trackspace-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --names backend,frontend --prefix-colors cyan,magenta \"cd .. && .venv/bin/python -m backend.app ${ROOT:-.}\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.7",
    "vite": "^6.2"
  },
  "dependencies": {
    "alpinejs": "^3.15.8",
    "htmx.org": "^2.0.8"
  }
}
